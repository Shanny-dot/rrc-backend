DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
# ZeptoMail (Zoho) send-mail token; used instead of Resend when set. FROM_EMAIL must be on a verified domain.
ZEPTOMAIL_API_KEY=
FROM_NAME=Reliance Rewards
FROM_EMAIL=
FIREBASE_CREDENTIALS_JSON=
# Random string of 32+ characters, e.g. `openssl rand -hex 32`. Never reuse the old hard-coded value.
JWT_SECRET=
ADMIN_EMAIL=
FRONTEND_URL=
# Audiences accepted for Sign in with Apple tokens (iOS bundle ID)
APPLE_CLIENT_IDS=com.rrc.referralapp
# Google sign-in: the Web OAuth client ID(s) the app uses (comma-separated). Empty = off.
GOOGLE_CLIENT_IDS=
# Facebook sign-in (App ID and App Secret from developers.facebook.com). Empty = off.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Guni SMS (gunisms.com.au) App Token from Integrations, used to send mobile OTPs. Empty = SMS off.
GUNI_SMS_API_KEY=
# Sender ID shown on OTP texts (must be approved in your Guni account)
GUNI_SMS_SENDER=Reliiance
# Shared secret for the daily alerts job (also set as the JOB_SECRET GitHub Actions secret)
JOB_SECRET=
